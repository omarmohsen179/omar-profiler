{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omarmohsen-dev",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "routes": [
    { "pattern": "omarmohsen.dev", "custom_domain": true },
    { "pattern": "www.omarmohsen.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "SMTP_HOST": "mail.privateemail.com",
    "SMTP_PORT": "465",
    "SMTP_USER": "contact@omarmohsen.dev",
    "SMTP_TO": "contact@omarmohsen.dev"
  },
  "observability": { "enabled": true }
}
